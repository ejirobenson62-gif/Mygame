body {
  background: linear-gradient(135deg, #008751, #FFD700, #008751);
  font-family: 'Arial Black', sans-serif;
  text-align: center;
  padding: 10px;
  color: #000;
}
.container {
  background: white;
  padding: 15px;
  border-radius: 20px;
  max-width: 400px;
  margin: auto;
  box-shadow: 0 8px 20px rgba(0,0,0,0.3);
  animation: pop 0.3s;
}
@keyframes pop { from {transform: scale(0.9);} to {transform: scale(1);} }
h1 { color: #008751; font-size: 22px; }
.stats { display: flex; justify-content: space-around; font-weight: bold; }
.option {
  width: 100%;
  padding: 18px;
  margin: 10px 0;
  font-size: 16px;
  border: 3px solid #008751;
  border-radius: 15px;
  background: #FFF9C4;
  cursor: pointer;
  transition: 0.2s;
}
.option:hover { background: #008751; color: white; transform: scale(1.05); }
.option:disabled { opacity: 0.5; cursor: not-allowed; }
.vs { font-weight: bold; font-size: 18px; color: red; }
#roast { font-style: italic; color: #d32f2f; font-size: 14px; }
#nextBtn, #restartBtn {
  padding: 12px 20px;
  background: #FFD700;
  color: #000;
  border: none;
  border-radius: 10px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}